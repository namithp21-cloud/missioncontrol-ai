# Copy to .env (git-ignored). Every variable is optional: with no AI key the app runs in clearly labelled DEMO MODE.
# Never commit real keys. Keys are read on the server only and are never sent to the browser.

# --- Server ---
PORT=3000
HOST=0.0.0.0
# Where the SQLite file lives. On a host, point this at a persistent disk (e.g. /data/missioncontrol.db).
DATABASE_PATH=./data/missioncontrol.db
# Set to 1 only when running behind a reverse proxy you control (so rate limits use the real client IP).
TRUST_PROXY=0

# --- AI provider (leave the keys empty for demo mode) ---
# Options: anthropic (default), bedrock (Amazon Bedrock Runtime), or openai (OpenAI-compatible API)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Amazon Bedrock example (uses @aws-sdk/client-bedrock-runtime Converse API):
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v1:0

# OpenAI-compatible example (LLM_MODEL is required for this provider):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=

# --- Cost / abuse guards for a public deployment ---
AGENT_DAILY_LIMIT=300
AGENT_RATE_PER_MINUTE=20
LLM_TIMEOUT_MS=60000

# --- Reproducible demos (optional) ---
# Pin the clock so the demo workspace and its dates are identical on every reset.
# MC_NOW=2026-10-20T09:00:00Z